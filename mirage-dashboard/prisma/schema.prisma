generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Lead {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String
  website         String?
  rating          Float?
  sponsored       String?
  email           String?
  instagram       String?
  linkedin        String?
  tem_pixel_meta  String?
  tem_google_ads  String?
  status          String?
  is_buyer        String?
  createdAt       DateTime @default(now())
}
